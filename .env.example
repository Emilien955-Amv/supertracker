# Modèle de configuration locale.
# Copiez ce fichier en « .env » (qui, lui, n'est JAMAIS versionné dans Git).

POSTGRES_USER=supertracker
POSTGRES_PASSWORD=change-moi-en-local
POSTGRES_DB=supertracker

# Clé de signature des jetons de connexion (facultative en local).
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Jeton TMDB : themoviedb.org > Paramètres > API > « Jeton d'accès en lecture à l'API ».
TMDB_API_TOKEN=

# development | test | staging | production
ENVIRONMENT=development
